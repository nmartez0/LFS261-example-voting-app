pipeline {
    agent any

    tools {
        nodejs 'NodeJS 22.4.0'
      }

    stages {
        stage("build") {
            when {
                changeset "**/result/**"
              }
          steps {
            echo 'Compiling result app'
            }
          }
        stage("test") {
            when {
                changeset "**/result/**"
              }
            steps {
                echo 'Runing Unit Test on result app'
              }
          }
      }
  post {
      always {
          echo 'Building multibranch pipeline for result app'
        }
    }
  }
